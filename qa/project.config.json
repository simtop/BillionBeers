  "scan": {
    "include": [
      "feature/*/src/main/**/*.kt",
      "shared/*/src/commonMain/**/*.kt",
      "app/src/main/**/*.kt",
      "web-app/src/wasmJsMain/**/*.kt",
      "web-app/src/commonMain/**/*.kt",
      "navigation/src/main/**/*.kt",
      "feature/*/src/main/res/values*/strings.xml",
      "presentation_utils/src/main/res/values*/strings.xml",
      "app/src/main/res/values*/strings.xml",
      "web-app/src/commonMain/composeResources/values*/strings.xml"
    ],
    "extractors": [
      {
        "kind": "component",
        "files": "*.kt",
        "pattern": "\\bfun\\s+([A-Za-z_]\\w*(?:Screen(?:Impl)?|Content|Destination))\\s*\\("
      },
      {
        "kind": "selector",
        "files": "*.kt",
        "pattern": "\\btestTag\\(\"([^\"\\n]+)\""
      },
      {
        "kind": "literal-text",
        "files": "*.kt",
        "pattern": "\\bText\\(\\s*(?:text\\s*=\\s*)?\"([^\"\\n]+)\""
      },
      {
        "kind": "resource-reference",
        "files": "*.kt",
        "pattern": "\\bstringResource\\(\\s*[\\w.]+\\.string\\.(\\w+)"
      },
      {
        "kind": "resource-text",
        "files": "*.xml",
        "pattern": "<string\\s+name=\"(?P<key>[^\"]+)\"[^>]*>(?P<value>[^<]+)</string>"
      },
      {
        "kind": "registered-route",
        "files": "*.kt",
        "pattern": "\\bentry<(\\w+)>"
      }
    ]
  }
}
