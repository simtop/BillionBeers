{
  "schema": 1,
  "screens": {
    "catalog": {
      "platform": "android",
      "renderer": "paparazzi",
      "record": [
        "make",
        "screenshot-record",
        "MODULE=:app",
        "GRADLE_RUNNER=./gradlew"
      ],
      "verify": [
        "make",
        "screenshot-verify",
        "MODULE=:app",
        "GRADLE_RUNNER=./gradlew"
      ],
      "image_directory": "app/src/test/snapshots/images",
      "sources": [
        "app/src/debug/**/*.kt",
        "app/src/main/java/com/simtop/billionbeers/presentation/AppBottomNavigation.kt",
        "app/src/main/res/values*/strings.xml",
